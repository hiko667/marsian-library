@model marsian_library.Models.Book

@{
    ViewData["Title"] = "Create Book";
}

<h1>Create Book</h1>

<h4>Book</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Isbn" class="control-label"></label>
                <input asp-for="Isbn" class="form-control" />
                <span asp-validation-for="Isbn" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PublisherId" class="control-label"></label>
                <select asp-for="PublisherId" class="form-control" asp-items="ViewBag.PublisherId">
                    <option value="">-- Select Publisher --</option>
                </select>
                <span asp-validation-for="PublisherId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Authors</label>
                <select name="selectedAuthors" class="form-control" asp-items="ViewBag.Authors" multiple></select>
                <small class="form-text text-muted">Hold Ctrl to select multiple authors</small>
            </div>

            <div class="form-group">
                <label class="control-label">Genres</label>
                <select name="selectedGenres" class="form-control" asp-items="ViewBag.Genres" multiple></select>
                <small class="form-text text-muted">Hold Ctrl to select multiple genres</small>
            </div>

            <div class="form-group">
                <label class="control-label">Languages</label>
                <select name="selectedLanguages" class="form-control" asp-items="ViewBag.Languages" multiple></select>
                <small class="form-text text-muted">Hold Ctrl to select multiple languages</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}