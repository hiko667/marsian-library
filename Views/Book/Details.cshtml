@model marsian_library.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>@Model.Title</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Book Information</h4>
        
        @{
            // looking for cover image on the server
            string coverPath = null;
            string[] extensions = { ".jpg", ".jpeg", ".png" };
            foreach (var ext in extensions)
            {
                var fullPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "covers", Model.Id + ext);
                if (System.IO.File.Exists(fullPath))
                {
                    coverPath = $"/covers/{Model.Id}{ext}?v={DateTime.Now.Ticks}";
                    break;
                }
            }
        }

        <div class="row">
            @if (coverPath != null)
            {
                <div class="col-sm-4 text-center mb-3">
                    <img src="@coverPath" alt="Book Cover" class="img-fluid rounded shadow-sm border" style="max-height: 280px; object-fit: cover;" />
                </div>

                <div class="col-sm-8">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 30%;">ISBN</th>
                            <td>@Model.Isbn</td>
                        </tr>
                        <tr>
                            <th>Publisher</th>
                            <td>@Model.Publisher?.Name</td>
                        </tr>
                        <tr>
                            <th>Authors</th>
                            <td>
                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var author in Model.Authors)
                                        {
                                            <li>@author.FullName</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Genres</th>
                            <td>
                                @if (Model.Genres != null && Model.Genres.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var genre in Model.Genres)
                                        {
                                            <li>@genre.Name</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Languages</th>
                            <td>
                                @if (Model.Languages != null && Model.Languages.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var language in Model.Languages)
                                        {
                                            <li>@language.Name</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            }
            else
            {
                <div class="col-sm-12">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 25%;">ISBN</th>
                            <td>@Model.Isbn</td>
                        </tr>
                        <tr>
                            <th>Publisher</th>
                            <td>@Model.Publisher?.Name</td>
                        </tr>
                        <tr>
                            <th>Authors</th>
                            <td>
                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var author in Model.Authors)
                                        {
                                            <li>@author.FullName</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Genres</th>
                            <td>
                                @if (Model.Genres != null && Model.Genres.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var genre in Model.Genres)
                                        {
                                            <li>@genre.Name</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Languages</th>
                            <td>
                                @if (Model.Languages != null && Model.Languages.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var language in Model.Languages)
                                        {
                                            <li>@language.Name</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <h4>Available Copies</h4>
        @{
            var copies = ViewBag.Copies as List<marsian_library.Models.Copy>;
        }
        @if (copies != null && copies.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Copy ID</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var copy in copies)
                    {
                        <tr>
                            <td>@copy.Id</td>
                            <td>@copy.Dept.Id</td>
                            <td>
                                <span class="badge @(copy.State?.Name == "Available" ? "bg-success" : "bg-warning")">
                                    @copy.State?.Name
                                </span>
                            </td>
                            <td>
                                @if (copy.State?.Name == "Available")
                                {
                                    <a asp-action="Borrow" asp-route-copyId="@copy.Id" class="btn btn-sm btn-primary">Borrow</a>
                                }
                                else
                                {
                                    var borrowers = ViewBag.CopyBorrowers as Dictionary<int, marsian_library.Models.Reader>;
                                    if (borrowers != null && borrowers.TryGetValue(copy.Id, out var borrower) && borrower != null)
                                    {
                                        <a asp-controller="Reader" asp-action="Details" asp-route-id="@borrower.Id" class="btn btn-sm btn-secondary">
                                            Borrowed by @($"{borrower.FirstName} {borrower.LastName}")
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled>Not Available</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No copies available.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Search</a>

    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Employee") || User.IsInRole("Admin")))
    {
        <a asp-controller="Book" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">Edit book</a>
        <a asp-controller="Book" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Delete book</a>
    }
</div>