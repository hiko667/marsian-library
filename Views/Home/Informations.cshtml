@{
    ViewData["Title"] = "Information";
}

<div class="container mt-4">
    <h1 class="mb-4">Marsian Library - Information</h1>

    <div class="card mb-4">
        <div class="card-body">
            <h3>Where to get a library card?</h3>
            <ul class="mb-0">
                <li><strong>By phone:</strong> 303 121 244</li>
                <li><strong>In person:</strong> Main Street Palace 1, 00-000 Forge World of Mars</li>
            </ul>
        </div>
    </div>

    <div class="accordion" id="infoAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                    Is the library card free?
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    Yes, but only for residents of the Milky Way.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                    Group tours
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    For group tours, please contact us at phone number: 303 121 201
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                    Archive Access
                </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    <ul class="mb-0">
                        <li>To obtain online access to the archive, please send a request to: archiwum@edu.mars</li>
                        <li>For on‑site access, please visit our library at 21 Crater Street (2nd floor), 99-989 Planet Mars</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour">
                    Languages available in the library
                </button>
            </h2>
            <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    We have books in every language described by the Milky Way Language Society. Languages can be checked on the official website: 
                    <a href="http://www.ߣߐߣߐߛߌߟߊ߫ߞߊ߲ߡߌ߬ߙߌ߲߬ߘߌ.gov" target="_blank">www.ߣߐߣߐߛߌߟߊ߫ߞߊ߲ߡߌ߬ߙߌ߲߬ߘߌ.gov</a>
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive">
                    Departments
                </button>
            </h2>
            <div id="collapseFive" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    Marsian Library consists of many departments on many planets. <br />
                    The main branch is located on Planet Mars: Main Street Palace 1, 00-000 Forge World of Mars and is open from 8:00 to 20:00 every day. <br />
                    All departments can be seen 
                    <a class="link" asp-area="" asp-controller="Dept" asp-action="Index">here</a>.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix">
                    Other questions
                </button>
            </h2>
            <div id="collapseSix" class="accordion-collapse collapse" data-bs-parent="#infoAccordion">
                <div class="accordion-body">
                    Please direct any other questions to:  piotr.nowak@library.com or call 303 121 244
                </div>
            </div>
        </div>
    </div>
</div>