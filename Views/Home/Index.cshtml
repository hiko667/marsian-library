@model marsian_library.Models.WeatherRaport
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <div class = "flex">
        <h2>Pogoda na Marsie (InSight)</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Sol</th>
                    <th>Sezon</th>
                    <th>Temp. Średnia (°C)</th>
                    <th>Temp. Min/Max (°C)</th>
                    <th>Ciśnienie Średnie (Pa)</th>
                    <th>Wiatr Średni (m/s)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solKey in Model.SolKeys)
                {
                    if (Model.Sols.TryGetValue(solKey, out var sol))
                    {
                        <tr>
                            <td>@solKey</td>
                            <td>@sol.Season</td>
                            <td>@(sol.AirTemperature?.Average.ToString("F1") ?? "Brak danych")</td>
                            <td>
                                @(sol.AirTemperature?.Minimum.ToString("F1") ?? "N/A") / 
                                @(sol.AirTemperature?.Maximum.ToString("F1") ?? "N/A")
                            </td>
                            <td>@(sol.AtmosphericPressure?.Average.ToString("F1") ?? "Brak danych")</td>
                            <td>@(sol.HorizontalWindSpeed?.Average.ToString("F1") ?? "Brak danych")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
