@{
    ViewData["Title"] = "Library Management Operations";
}

<div class="text-center">
    <h1 class="display-4">Library Management Operations</h1>
    <p>for employees only</p>
</div>

<div class="row">

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Book" asp-action="Index">Books</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage book collection, including adding new books, editing existing ones, and
                    keeping track of the library's inventory.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Author" asp-action="Index">Authors</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage author information, including adding new authors, editing existing ones.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Genre" asp-action="Index">Genres</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage genre information, including adding new genres, editing existing ones.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Publisher" asp-action="Index">Publishers</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage publisher information, including adding new publishers, editing existing
                    ones.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Language" asp-action="Index">Languages</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage language information, including adding new languages, editing existing ones.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Dept" asp-action="Index">Departments</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage department information, including adding new departments, editing existing
                    ones. [Admin only]</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Reader" asp-action="Index">Readers</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage reader information, including adding new readers, editing existing
                    ones.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title center">
                    <a class="nav-link" asp-area="" asp-controller="Borrow" asp-action="Index">Borrowings</a>
                </h5>
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text">Manage borrowing information, including adding new borrowings, editing existing
                    ones.</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow border-primary">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title text-primary">
                        <i class="bi bi-cloud-arrow-up-fill"></i> Upload File
                    </h5>
                    
                    <form asp-controller="Home" asp-action="UploadFile" method="post" enctype="multipart/form-data" class="mt-3">
                        <div class="mb-2">
                            <input class="form-control form-control-sm" type="file" name="file" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-sm btn-primary bg-gradient">
                                <i class="bi bi-upload"></i> Upload on Server
                            </button>
                        </div>
                    </form>
                </div>

                @{
                    var successMsg = TempData["SuccessMessage"];
                    var errorMsg = TempData["ErrorMessage"];
                }

                @if (successMsg != null || errorMsg != null)
                {
                    <div class="mt-3">
                        @if (successMsg != null)
                        {
                            <div class="p-2 small rounded bg-success-subtle text-success border border-success-subtle animate-fade">
                                <i class="bi bi-file-earmark-check-fill me-1"></i> <strong>Success:</strong> @successMsg
                            </div>
                        }
                        @if (errorMsg != null)
                        {
                            <div class="p-2 small rounded bg-danger-subtle text-danger border border-danger-subtle animate-fade">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i> <strong>Error:</strong> @errorMsg
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent">
                <p class="card-text text-muted small">Upload any local file (PDF, XLSX, CSV) to the internal application storage directory on the server.</p>
            </div>
        </div>
    </div>

</div>