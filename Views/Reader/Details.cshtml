@model marsian_library.Models.Reader

@{
    ViewData["Title"] = "Reader Details";
}

<h1>Reader Details</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <strong>Reader Information</strong>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">
                        @if (Model.Address != null)
                        {
                            @Model.Address.FullAddress
                        }
                        else
                        {
                            <span class="text-muted">No address on file</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Current Borrowed Books</strong>
                <a asp-action="BorrowHistory" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">View all history</a>
            </div>
            <div class="card-body">
                @{
                    var currentBorrows = ViewBag.CurrentBorrows as List<marsian_library.Controllers.BorrowInfo>;
                }
                @if (currentBorrows != null && currentBorrows.Any())
                {
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Copy ID</th>
                                <th>Dept ID</th>
                                <th>Borrowed</th>
                                <th>Due</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var borrow in currentBorrows)
                            {
                                <tr>
                                    <td>@borrow.BookTitle</td>
                                    <td>@borrow.Author</td>
                                    <td>@borrow.CopyId</td>
                                    <td>@borrow.DeptId</td>
                                    <td>@borrow.BorrowDate.ToShortDateString()</td>
                                    <td>@borrow.ExpectedReturnDate.ToShortDateString()</td>
                                    <td>
                                        <form asp-controller="Borrow" asp-action="Return" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@borrow.BorrowId" />
                                            <input type="hidden" name="readerId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
                                        </form>
                                    </td>   
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No currently borrowed books.</p>
                }
            </div>
        </div>
    </div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="BorrowHistory" asp-route-id="@Model.Id" class="btn btn-info">Borrow History</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
