@model marsian_library.Models.Dept

@{
    ViewData["Title"] = "Create Department";
}

<h1>Create Department</h1>

<h4>Department</h4>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Wybór dyrektora -->
            <div class="form-group">
                <label asp-for="DirectorId" class="control-label">Director</label>
                <select asp-for="DirectorId" class="form-control" asp-items="ViewBag.DirectorId">
                    <option value="">-- Select Director --</option>
                </select>
                <span asp-validation-for="DirectorId" class="text-danger"></span>
            </div>

            <!-- Wybór adresu -->
            <div class="form-group">
                <label class="control-label">Address</label>
                <div class="mb-2">
                    <div class="form-check">
                        <input type="radio" id="useExistingAddress" name="useExistingAddress" value="true" class="form-check-input" checked />
                        <label for="useExistingAddress" class="form-check-label">Use existing address</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" id="createNewAddress" name="useExistingAddress" value="false" class="form-check-input" />
                        <label for="createNewAddress" class="form-check-label">Create new address</label>
                    </div>
                </div>
            </div>

            <!-- Istniejący adres -->
            <div id="existingAddressSection" class="form-group">
                <label class="control-label">Select Existing Address</label>
                <select name="existingAddressId" class="form-control" asp-items="ViewBag.ExistingAddresses">
                    <option value="">-- Select Address --</option>
                </select>
            </div>

            <!-- Nowy adres (początkowo ukryty) -->
            <div id="newAddressSection" style="display: none;">
                <div class="card mt-2 mb-3">
                    <div class="card-header">
                        <strong>New Address Details</strong>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="control-label">City *</label>
                            <input name="address.City" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Street *</label>
                            <input name="address.Street" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Building *</label>
                            <input name="address.Building" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Apartment</label>
                            <input name="address.Apartment" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Zip Code *</label>
                            <input name="address.ZipCode" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Przełączanie między istniejącym a nowym adresem
        const useExistingRadio = document.getElementById('useExistingAddress');
        const createNewRadio = document.getElementById('createNewAddress');
        const existingSection = document.getElementById('existingAddressSection');
        const newSection = document.getElementById('newAddressSection');

        function toggleAddressSections() {
            if (useExistingRadio.checked) {
                existingSection.style.display = 'block';
                newSection.style.display = 'none';
                // Wyłącz wymaganie dla pól nowego adresu
                document.querySelectorAll('#newAddressSection input').forEach(input => {
                    input.required = false;
                });
                // Włącz wymaganie dla wyboru istniejącego adresu
                const existingSelect = document.querySelector('select[name="existingAddressId"]');
                if (existingSelect) existingSelect.required = true;
            } else {
                existingSection.style.display = 'none';
                newSection.style.display = 'block';
                // Włącz wymaganie dla pól nowego adresu
                document.querySelectorAll('#newAddressSection input[name*="address."]').forEach(input => {
                    if (input.name === 'address.Apartment') {
                        input.required = false; // Apartment jest opcjonalny
                    } else {
                        input.required = true;
                    }
                });
                // Wyłącz wymaganie dla wyboru istniejącego adresu
                const existingSelect = document.querySelector('select[name="existingAddressId"]');
                if (existingSelect) existingSelect.required = false;
            }
        }

        useExistingRadio.addEventListener('change', toggleAddressSections);
        createNewRadio.addEventListener('change', toggleAddressSections);

        // Inicjalizacja
        toggleAddressSections();
    </script>
}