@model marsian_library.Models.Borrow

@{
    ViewData["Title"] = "Borrow Book";
}

<h1>Borrow Book</h1>

<div class="alert alert-info">
    <strong>Copy:</strong> @ViewBag.CopyInfo
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Borrow">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CopyId" />

            <div class="form-group">
                <label asp-for="ReaderId" class="control-label"></label>
                <select asp-for="ReaderId" class="form-control" asp-items="ViewBag.ReaderId">
                    <option value="">-- Select Reader --</option>
                </select>
                <span asp-validation-for="ReaderId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExpectedReturnDate" class="control-label"></label>
                <input asp-for="ExpectedReturnDate" class="form-control" type="date" />
                <span asp-validation-for="ExpectedReturnDate" class="text-danger"></span>
                <small class="form-text text-muted">Default is 14 days from today.</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Confirm Borrow" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}